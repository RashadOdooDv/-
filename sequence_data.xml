<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_overhead_allocation" model="ir.sequence">
        <field name="name">Overhead Allocation</field>
        <field name="code">overhead.allocation</field>
        <field name="prefix">OH/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

    <record id="seq_contract_progress_billing" model="ir.sequence">
        <field name="name">Contract Progress Billing (IPC)</field>
