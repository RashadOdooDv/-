        <field name="prefix">VO/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_contract_retention_release" model="ir.sequence">
        <field name="name">Contract Retention Release</field>
        <field name="code">contract.retention.release</field>
        <field name="prefix">RET/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
