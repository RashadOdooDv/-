<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_contracting" model="ir.module.category">
        <field name="name">Contracting Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_contracting_user" model="res.groups">
        <field name="name">Contracting User (Engineer/Project Accountant)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_contracting_manager" model="res.groups">
        <field name="name">Contracting Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_contracting_user'))]"/>
    </record>

    <!-- Keep contracting records within the user's enabled companies. -->
    <record id="rule_boq_item_company" model="ir.rule">
        <field name="name">BOQ Items: Enabled Companies</field>
        <field name="model_id" ref="model_boq_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_boq_line_analysis_company" model="ir.rule">
        <field name="name">BOQ Analysis: Enabled Companies</field>
        <field name="model_id" ref="model_boq_line_analysis"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_overhead_allocation_company" model="ir.rule">
        <field name="name">Overhead Allocations: Enabled Companies</field>
        <field name="model_id" ref="model_overhead_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_overhead_allocation_line_company" model="ir.rule">
        <field name="name">Overhead Allocation Lines: Enabled Companies</field>
        <field name="model_id" ref="model_overhead_allocation_line"/>
        <field name="domain_force">[('allocation_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_boq_item_manager_all" model="ir.rule">
        <field name="name">Contracting Manager: All BOQ Items</field>
        <field name="model_id" ref="model_boq_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_contracting_manager'))]"/>
    </record>
</odoo>

    <record id="rule_contract_progress_billing_company" model="ir.rule">
        <field name="name">Contracting: IPC by Company</field>
        <field name="model_id" ref="model_contract_progress_billing"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_contracting_user')), (4, ref('group_contracting_manager'))]"/>
    </record>

    <record id="rule_contract_variation_order_company" model="ir.rule">
        <field name="name">Contracting: VO by Company</field>
        <field name="model_id" ref="model_contract_variation_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_contracting_user')), (4, ref('group_contracting_manager'))]"/>
    </record>

    <record id="rule_contract_retention_release_company" model="ir.rule">
        <field name="name">Contracting: Retention Release by Company</field>
        <field name="model_id" ref="model_contract_retention_release"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_contracting_user')), (4, ref('group_contracting_manager'))]"/>
    </record>
