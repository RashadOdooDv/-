<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_contracting" model="ir.ui.view">
        <field name="name">account.move.form.inherit.contracting</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- حقل المشروع في رأس المستند -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="project_id" options="{'no_create': True}"/>
            </xpath>

            <!-- عمود بند BOQ داخل سطور الفاتورة -->
            <xpath expr="//field[@name='invoice_line_ids']//list" position="inside">
                <field name="boq_item_id" optional="show"/>
                <field name="is_general_expense" optional="show"/>
            </xpath>

            <!-- عمود بند BOQ داخل سطور قيود اليومية (تبويب Journal Items) -->
            <xpath expr="//field[@name='line_ids']//list" position="inside">
                <field name="boq_item_id" optional="show"/>
                <field name="is_general_expense" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
